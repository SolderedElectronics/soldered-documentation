# Deploy configuration - copy this file to "deploy.env" and fill in your values.
#
#   cp deploy.env.example deploy.env      (Git Bash / macOS / Linux)
#   copy deploy.env.example deploy.env    (Windows cmd)
#
# deploy.env is gitignored - never commit it, and never put a private key in it.
# Ask whoever administers the docs server for the REMOTE_HOST value.

# Server to deploy to.
REMOTE_HOST=

# Deploy account on the server. This is NOT root.
REMOTE_USER=deploy

# Where the built site is served from on the server.
REMOTE_PATH=/var/www/docs.soldered.com/html

# Path to YOUR OWN private SSH key (the file WITHOUT the .pub extension).
# Git Bash on Windows:  $HOME/.ssh/id_ed25519
# macOS / Linux:        $HOME/.ssh/id_ed25519
SSH_KEY=$HOME/.ssh/id_ed25519
